{
  "name": "jobbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generic job auto-apply engine. Datadog is the first site pack; add more by dropping in a site.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "install:chrome": "wxt build && mkdir -p ~/.jobbot/extension && rsync -a --delete .output/chrome-mv3/ ~/.jobbot/extension/",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsc --noEmit && vitest run && wxt build",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "mitm": "debug/launch.sh",
    "mitm:stop": "debug/stop.sh",
    "mitm:reset": "debug/reset.sh",
    "fixture:amazon": "node debug/amazon-fixture.mjs",
    "tailor": "node scripts/tailor-resume.ts",
    "probe": "vite-node scripts/probe-form.ts --"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.0.268",
    "fake-indexeddb": "6.0.0",
    "happy-dom": "^15.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wxt": "^0.19.0"
  },
  "dependencies": {
    "@preact/signals": "1.3.0",
    "preact": "10.24.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  }
}
